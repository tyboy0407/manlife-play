; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ManLife"
run/main_scene="res://game/levels/harbor.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.11, 0.2, 0.38, 1)
boot_splash/image="res://assets/icons/splash.png"
boot_splash/fullsize=true
config/icon="res://assets/icons/icon_128.png"

[autoload]

EventBus="*res://autoload/event_bus.gd"
GameState="*res://autoload/game_state.gd"
SaveManager="*res://autoload/save_manager.gd"
Settings="*res://autoload/settings.gd"
Sfx="*res://autoload/sfx.gd"
Fx="*res://autoload/fly_fx.gd"

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom_font="res://assets/fonts/NotoSansTC-VF.ttf"

[input_devices]

pointing/emulate_touch_from_mouse=true

